{
  "name": "dmc-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "sidecar:test": "python -m pytest apps/sidecar/tests",
    "sidecar:typecheck": "python -m mypy --strict apps/sidecar/dmc_sidecar",
    "cloud:dev": "uvicorn apps.cloud.app.main:app --reload",
    "cloud:test": "python -m pytest apps/cloud/tests"
  }
}
