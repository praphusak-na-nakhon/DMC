{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DMC Assistant",
  "version": "0.1.0",
  "identifier": "info.bopp.dmcassistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DMC Assistant",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "bundled-sidecar",
      "release-config"
    ],
    "targets": "msi"
  }
}
